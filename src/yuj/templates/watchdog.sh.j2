#!/usr/bin/env bash
# yuj-watchdog for job "{{ job }}", generated by `yuj submit`; do not edit.
# Supervises the work loop: relaunches it if the process dies or output stalls
# (no new file in STALL_MIN minutes). A GRACE window after each (re)launch
# suppresses restarts while a slow job warms up.
set -uo pipefail

cd "$HOME/{{ remote_dir }}" || exit 1
JOB="{{ job }}"
STOP="{{ stop_sentinel }}"
RUN="{{ run_script }}"
LOGDIR="logs"
LOG="$LOGDIR/${JOB}.watchdog.log"
INTERVAL={{ interval_sec }}
STALL_MIN={{ stall_min }}
GRACE={{ grace_sec }}
PGID_FILE=".${JOB}.run.pgid"   # process-group id of the most recent run
mkdir -p "$LOGDIR"

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# Kill a run and all descendants via its setsid process group, else orphans pile
# up across relaunches until OOM. Pattern-kill fallback when no pgid (e.g. macOS).
stop_run() {
    local pgid
    pgid=$(cat "$PGID_FILE" 2>/dev/null)
    if [ -n "$pgid" ] && kill -0 "-$pgid" 2>/dev/null; then
        kill -TERM "-$pgid" 2>/dev/null
        sleep 3
        kill -KILL "-$pgid" 2>/dev/null
    fi
    pkill -f "[b]ash $RUN" 2>/dev/null
}
{% if has_window %}
# Active window: only run between {{ window_label }} (minutes since midnight,
# wrapping past midnight when start > end). Outside it the work loop is paused
# and not relaunched, so the host's owner gets their machine back during the day.
WIN_START={{ window_start_min }}
WIN_END={{ window_end_min }}
within_window() {
    local now
    now=$((10#$(date +%H) * 60 + 10#$(date +%M)))
    if [ "$WIN_START" -eq "$WIN_END" ]; then return 0; fi
    if [ "$WIN_START" -lt "$WIN_END" ]; then
        [ "$now" -ge "$WIN_START" ] && [ "$now" -lt "$WIN_END" ]
    else
        [ "$now" -ge "$WIN_START" ] || [ "$now" -lt "$WIN_END" ]
    fi
}
pause_work() {
    stop_run
{% if off_window_command %}    {{ off_window_command }}
{% endif %}
}
{% endif %}
{% if courtesy %}
# Courtesy: share the GPUs. A card carrying anyone else's compute is theirs,
# however little memory they hold. Mirrors yuj.sizing.courteous_gpus; keep the
# two in step.
GPU_FILE="{{ gpu_file }}"
TOTAL_WORKERS={{ concurrency }}
ME=$(id -un)
HAVE_SMI=0
command -v nvidia-smi >/dev/null 2>&1 && HAVE_SMI=1
ALLOWED=""

# Prints the space-separated indices of cards with no foreign process.
# One awk pass over (index,uuid) then (uuid,owner) keeps it portable: no bash-4
# associative arrays, so this still works on macOS bash 3.2.
gpu_courtesy_list() {
    {
        nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null \
            | tr -d ' ' | sed 's/^/G,/'
        nvidia-smi --query-compute-apps=gpu_uuid,pid --format=csv,noheader 2>/dev/null \
            | tr -d ' ' | while IFS=, read -r uuid pid; do
                [ -z "$pid" ] && continue
                echo "P,${uuid},$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')"
            done
    } | awk -F, -v me="$ME" '
        $1=="G" { idx[$3]=$2; order[++n]=$3 }
        $1=="P" && $3!="" && $3!=me { busy[$2]=1 }
        END { for (i=1;i<=n;i++) if (!(order[i] in busy)) printf "%s ", idx[order[i]] }'
}

# Sets ALLOWED and writes GPUS/WORKERS_PER_GPU for the run script to source.
# Returns 0 when the allowed set changed since the last tick.
refresh_courtesy() {
    local list prev="$ALLOWED"
    if [ "$HAVE_SMI" -eq 0 ]; then
        rm -f "$GPU_FILE"
        return 1
    fi
    list=$(gpu_courtesy_list | sed 's/[[:space:]]*$//')
    # More idle cards than workers: take the first TOTAL_WORKERS of them, so no
    # card is sized to zero and the two lists stay the same length.
    list=$(echo "$list" | awk -v t="$TOTAL_WORKERS" \
        '{ n = (NF > t ? t : NF); for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? " " : ""), $i }')
    ALLOWED="$list"
    {
        echo "GPUS=\"$list\""
        echo "WORKERS_PER_GPU=\"$(awk -v t="$TOTAL_WORKERS" -v l="$list" 'BEGIN {
            n = split(l, a, " "); if (!n) exit
            b = int(t / n); e = t % n
            for (i = 0; i < n; i++) printf "%s%d", (i ? " " : ""), b + (i < e) }')\""
    } >"$GPU_FILE"
    [ "$list" != "$prev" ]
}

# A host with no nvidia-smi has nothing to share, so it runs unrestricted.
have_gpu() { [ "$HAVE_SMI" -eq 0 ] || [ -n "$ALLOWED" ]; }
{% endif %}

# Count processes matching a pattern. Bracket the first char so the grep does
# not match its own argv.
# shellcheck disable=SC2009  # bracket-grep on ps args is intentional and portable
count() { ps -eo args 2>/dev/null | grep -c "$1"; }

newest_age_min() {
    local n
    # shellcheck disable=SC2012  # ls -t by mtime is sufficient for stall detection
    n=$(ls -t {{ results_glob }} 2>/dev/null | head -1)
    [ -z "$n" ] && { echo 999999; return; }
    echo $(((  $(date +%s) - $(stat -c %Y "$n") ) / 60))
}

relaunch() {
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    # Reap any survivors from the previous run's group before starting fresh.
    stop_run
    if command -v setsid >/dev/null 2>&1; then
        # New session: PGID == wrapper PID, so stop_run can kill the whole group.
        setsid bash "$RUN" </dev/null >>"$LOGDIR/${JOB}.run_${ts}.log" 2>&1 &
        echo "$!" >"$PGID_FILE"
        log "relaunched $RUN (pgid $!) -> ${JOB}.run_${ts}.log"
    else
        nohup bash "$RUN" </dev/null >>"$LOGDIR/${JOB}.run_${ts}.log" 2>&1 &
        rm -f "$PGID_FILE"
        log "relaunched $RUN (no setsid; pattern-kill only) -> ${JOB}.run_${ts}.log"
    fi
}

{% if courtesy %}
start_work() { if have_gpu; then relaunch; else log "courtesy: every card busy; waiting"; fi; }
{% else %}
start_work() { relaunch; }
{% endif %}

# Single-instance guard: kill any other watchdog for this job, keep self.
for p in $(ps -eo pid,args 2>/dev/null | awk -v j="$JOB" '/yuj-watchdog/ && $0 ~ j {print $1}'); do
    [ "$p" != "$$" ] && kill "$p" 2>/dev/null
done

last_action=$(date +%s)
{% if courtesy %}
refresh_courtesy
log "courtesy: cards allowed = [$ALLOWED]"
{% endif %}
{% if has_window %}
if within_window; then
    start_work
else
    log "outside active window {{ window_label }}; not starting yet"
fi
{% else %}
start_work
{% endif %}
while [ ! -f "$STOP" ]; do
    sleep "$INTERVAL"
    [ -f "$STOP" ] && break
{% if has_window %}
    if ! within_window; then
        if [ "$(count "[b]ash $RUN")" -gt 0 ]; then
            log "ACTION: outside active window {{ window_label }} -> pause work"
            pause_work
        fi
        continue
    fi
{% endif %}
{% if courtesy %}
    # Re-read the cards ahead of the stall logic so an owner returning to a GPU
    # gets it back on this tick.
    if refresh_courtesy && have_gpu; then
        log "ACTION: courtesy -> cards changed to [$ALLOWED]; relaunch"
        relaunch
        last_action=$(date +%s)
        continue
    fi
    # Checked every tick, not just on a change: a watchdog restarted by cron
    # starts with no record of the previous set and must still yield.
    if ! have_gpu; then
        if [ "$(count "[b]ash $RUN")" -gt 0 ]; then
            log "ACTION: courtesy -> every card busy; pausing"
            stop_run
        else
            log "courtesy: every card busy; waiting"
        fi
        continue
    fi
{% endif %}
    run_n=$(count "[b]ash $RUN")
    age=$(newest_age_min)
    now=$(date +%s)
    within_grace=$((now - last_action < GRACE ? 1 : 0))
    if [ "$run_n" -eq 0 ]; then
        if [ "$within_grace" -eq 1 ]; then
            log "run down (age=${age}m) but within grace; waiting"
        else
            log "ACTION: run not running (age=${age}m) -> relaunch"
            relaunch
            last_action=$(date +%s)
        fi
    elif [ "$age" -ge "$STALL_MIN" ]; then
        if [ "$within_grace" -eq 1 ]; then
            log "stale (age=${age}m) but within grace; waiting"
        else
            log "ACTION: STALL age=${age}m >= ${STALL_MIN}m -> kill + relaunch"
            stop_run
            sleep 3
            relaunch
            last_action=$(date +%s)
        fi
    else
        log "ok: run=${run_n} age=${age}m"
    fi
done
# reap the run group before exiting, else stop leaves workers unsupervised
stop_run
log "stop sentinel present -> stopped run group and exiting"
