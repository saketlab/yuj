#!/usr/bin/env bash
# yuj-watchdog for job "{{ job }}", generated by `yuj submit`; do not edit.
# Supervises the work loop: relaunches it if the process dies or output stalls
# (no new file in STALL_MIN minutes). A GRACE window after each (re)launch
# suppresses restarts while a slow job warms up.
set -uo pipefail

cd "$HOME/{{ remote_dir }}" || exit 1
JOB="{{ job }}"
STOP="{{ stop_sentinel }}"
RUN="{{ run_script }}"
LOGDIR="logs"
LOG="$LOGDIR/${JOB}.watchdog.log"
INTERVAL={{ interval_sec }}
STALL_MIN={{ stall_min }}
GRACE={{ grace_sec }}
mkdir -p "$LOGDIR"

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }
{% if has_window %}
# Active window: only run between {{ window_label }} (minutes since midnight,
# wrapping past midnight when start > end). Outside it the work loop is paused
# and not relaunched, so the host's owner gets their machine back during the day.
WIN_START={{ window_start_min }}
WIN_END={{ window_end_min }}
within_window() {
    local now
    now=$((10#$(date +%H) * 60 + 10#$(date +%M)))
    if [ "$WIN_START" -eq "$WIN_END" ]; then return 0; fi
    if [ "$WIN_START" -lt "$WIN_END" ]; then
        [ "$now" -ge "$WIN_START" ] && [ "$now" -lt "$WIN_END" ]
    else
        [ "$now" -ge "$WIN_START" ] || [ "$now" -lt "$WIN_END" ]
    fi
}
pause_work() {
    pkill -f "[b]ash $RUN" 2>/dev/null
{% if off_window_command %}    {{ off_window_command }}
{% endif %}
}
{% endif %}

# Count processes matching a pattern. Bracket the first char so the grep does
# not match its own argv.
# shellcheck disable=SC2009  # bracket-grep on ps args is intentional and portable
count() { ps -eo args 2>/dev/null | grep -c "$1"; }

newest_age_min() {
    local n
    # shellcheck disable=SC2012  # ls -t by mtime is sufficient for stall detection
    n=$(ls -t {{ results_glob }} 2>/dev/null | head -1)
    [ -z "$n" ] && { echo 999999; return; }
    echo $(((  $(date +%s) - $(stat -c %Y "$n") ) / 60))
}

relaunch() {
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    nohup bash "$RUN" </dev/null >>"$LOGDIR/${JOB}.run_${ts}.log" 2>&1 &
    log "relaunched $RUN -> ${JOB}.run_${ts}.log"
}

# Single-instance guard: kill any other watchdog for this job, keep self.
for p in $(ps -eo pid,args 2>/dev/null | awk -v j="$JOB" '/yuj-watchdog/ && $0 ~ j {print $1}'); do
    [ "$p" != "$$" ] && kill "$p" 2>/dev/null
done

last_action=$(date +%s)
{% if has_window %}
if within_window; then
    relaunch
else
    log "outside active window {{ window_label }}; not starting yet"
fi
{% else %}
relaunch
{% endif %}
while [ ! -f "$STOP" ]; do
    sleep "$INTERVAL"
    [ -f "$STOP" ] && break
{% if has_window %}
    if ! within_window; then
        if [ "$(count "[b]ash $RUN")" -gt 0 ]; then
            log "ACTION: outside active window {{ window_label }} -> pause work"
            pause_work
        fi
        continue
    fi
{% endif %}
    run_n=$(count "[b]ash $RUN")
    age=$(newest_age_min)
    now=$(date +%s)
    within_grace=$((now - last_action < GRACE ? 1 : 0))
    if [ "$run_n" -eq 0 ]; then
        if [ "$within_grace" -eq 1 ]; then
            log "run down (age=${age}m) but within grace; waiting"
        else
            log "ACTION: run not running (age=${age}m) -> relaunch"
            relaunch
            last_action=$(date +%s)
        fi
    elif [ "$age" -ge "$STALL_MIN" ]; then
        if [ "$within_grace" -eq 1 ]; then
            log "stale (age=${age}m) but within grace; waiting"
        else
            log "ACTION: STALL age=${age}m >= ${STALL_MIN}m -> kill + relaunch"
            pkill -f "[b]ash $RUN" 2>/dev/null
            sleep 3
            relaunch
            last_action=$(date +%s)
        fi
    else
        log "ok: run=${run_n} age=${age}m"
    fi
done
log "stop sentinel present -> exiting"
