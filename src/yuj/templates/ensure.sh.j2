#!/usr/bin/env bash
# yuj-ensure for job "{{ job }}", generated by `yuj submit`; do not edit.
# Cron runs this every {{ cron_minutes }} min. It restarts the watchdog if it
# died or the host rebooted (which wipes /tmp and any running process). It is a
# no-op if the watchdog is already running or the job was intentionally stopped.
STOP="{{ stop_sentinel }}"
[ -f "$STOP" ] && exit 0

WD="$HOME/{{ remote_dir }}/{{ watchdog_script }}"
# shellcheck disable=SC2009  # bracket-grep on ps args is intentional and portable
ps -eo args 2>/dev/null | grep -q "[b]ash $WD" && exit 0
# bash runs it, so readable is enough; +x can be lost on re-sync
[ -f "$WD" ] || exit 0
cd "$HOME/{{ remote_dir }}" 2>/dev/null || exit 0

mkdir -p logs
nohup bash "$WD" </dev/null >>"logs/{{ job }}.watchdog.log" 2>&1 &
