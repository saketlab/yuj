#!/usr/bin/env bash
# yuj work loop for job "{{ job }}", generated by `yuj submit`; do not edit.
# Regenerate with `yuj submit`. The watchdog relaunches this if it dies/stalls.
set -uo pipefail

cd "$HOME/{{ remote_dir }}" || exit 1

# Source the environment `yuj bootstrap` wrote (env manager + extras), if present.
# shellcheck disable=SC1091
[ -f env.sh ] && . ./env.sh
{% if gpus %}
export GPUS="{{ gpus }}"
export WORKERS_PER_GPU="{{ workers_per_gpu }}"
{% endif %}
{% if courtesy %}
# The watchdog rewrites this each tick with the cards nobody else is on, and
# relaunches us when the set changes. No file means no nvidia-smi: unrestricted.
# shellcheck disable=SC1091
if [ -f "{{ gpu_file }}" ]; then
    . "./{{ gpu_file }}"
    export GPUS WORKERS_PER_GPU
fi
{% endif %}
{% if input_file %}
INPUT="{{ input_file }}"
OUTDIR="{{ output_dir }}"
mkdir -p "$OUTDIR"
# Tell the worker where to write, so it and the resume check agree.
export YUJ_OUT="$OUTDIR"

# Resume by output-file presence: skip any item whose output already exists.
# This is the only reliable resume mechanism when a worker crashes mid-write.
run_item() {
    item="$1"
    [ -z "$item" ] && return 0
    out="${OUTDIR}/${item}{{ output_suffix }}"
    [ -e "$out" ] && return 0
    # shellcheck disable=SC2086  # work_command is a command line, expanded on purpose
    {{ work_command }} "$item"
}
{% if concurrency and concurrency > 1 %}
# I/O-bound, so overlap up to {{ concurrency }} items
export OUTDIR YUJ_OUT
export -f run_item
# shellcheck disable=SC2016
grep -v '^[[:space:]]*$' "$INPUT" \
    | xargs -P {{ concurrency }} -I '{}' bash -c 'run_item "$@"' _ '{}'
{% else %}
while IFS= read -r item; do
    run_item "$item"
done < "$INPUT"
{% endif %}
{% else %}
# Batch mode: the work command processes its whole assigned input and is itself
# responsible for resume (skipping work whose output already exists).
# shellcheck disable=SC2086
{{ work_command }}
{% endif %}
